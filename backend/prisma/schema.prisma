generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WhatsAppInstanceStatus {
  CONNECTED
  CONNECTING
  DISCONNECTED
  ERROR
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  REACTION
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum BillingChargeStatus {
  PENDING
  PAID
  CANCELED
}

enum BillingRecurrenceFrequency {
  MONTHLY
}

enum BillingReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum BillingReminderOrigin {
  AUTOMATIC
  MANUAL
}

enum BulkMediaBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum BulkMediaRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum ScheduledMessageType {
  CAMPAIGN
  REMINDER
}

enum ScheduledMessageStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELED
}

enum ScheduledMessageRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduledMessageRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum WebhookExecutionStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum LeadStageKind {
  OPEN
  WON
  LOST
}

model Tenant {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  whatsappInstanceLimit Int      @default(3) @map("whatsapp_instance_limit")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  members                    TenantUser[]
  refreshTokens              RefreshToken[]
  customers                  Customer[]
  contacts                   Contact[]
  tags                       Tag[]
  customerTags               CustomerTag[]
  conversationTags           ConversationTag[]
  leadTags                   LeadTag[]
  quickReplies               QuickReply[]
  whatsappInstances          WhatsAppInstance[]
  whatsappAvatars            WhatsAppAvatar[]
  conversations              Conversation[]
  messages                   Message[]
  messageAttachments         MessageAttachment[]
  webhookEvents              WebhookEvent[]
  billingCharges             BillingCharge[]
  billingRecurrences         BillingRecurrence[]
  billingSettings            BillingSettings?
  billingReminders           BillingReminder[]
  bulkMediaBatches           BulkMediaBatch[]
  bulkMediaRecipients        BulkMediaRecipient[]
  scheduledMessages          ScheduledMessage[]
  scheduledMessageRecipients ScheduledMessageRecipient[]
  modules                    TenantModule[]
  webhookIntegrations        WebhookIntegration[]
  webhookExecutions          WebhookExecution[]
  linkPreviews               LinkPreview[]
  leadPipelines              LeadPipeline[]
  leadStages                 LeadStage[]
  leads                      Lead[]
  customMenuGroups           CustomMenuGroup[]
  customMenuButtons          CustomMenuButton[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   TenantUser[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model TenantUser {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedLeads Lead[] @relation("LeadOwner")

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  document  String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  tags               CustomerTag[]
  conversations      Conversation[]
  billingCharges     BillingCharge[]
  billingRecurrences BillingRecurrence[]

  @@unique([tenantId, document])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("customers")
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  position   String?
  avatarUrl  String?  @map("avatar_url")
  isPrimary  Boolean  @default(false) @map("is_primary")
  isBlocked  Boolean  @default(false) @map("is_blocked")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  billingCharges     BillingCharge[]
  billingRecurrences BillingRecurrence[]
  leads              Lead[]

  @@unique([tenantId, phone])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

model LeadPipeline {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages LeadStage[]
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("lead_pipelines")
}

model LeadStage {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  pipelineId String        @map("pipeline_id") @db.Uuid
  name       String
  color      String?
  position   Int
  kind       LeadStageKind @default(OPEN)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline LeadPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, position])
  @@index([tenantId, pipelineId])
  @@map("lead_stages")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  pipelineId     String     @map("pipeline_id") @db.Uuid
  stageId        String     @map("stage_id") @db.Uuid
  contactId      String     @map("contact_id") @db.Uuid
  ownerId        String?    @map("owner_id") @db.Uuid
  title          String
  source         String?
  valueCents     Int        @default(0) @map("value_cents")
  status         LeadStatus @default(OPEN)
  notes          String?
  nextFollowUpAt DateTime?  @map("next_follow_up_at")
  closedAt       DateTime?  @map("closed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline LeadPipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage    LeadStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact  Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner    TenantUser?  @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags     LeadTag[]

  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, ownerId])
  @@index([tenantId, nextFollowUpAt])
  @@map("leads")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers     CustomerTag[]
  conversations ConversationTag[]
  leads         LeadTag[]

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
  @@map("tags")
}

model QuickReply {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, title])
  @@index([tenantId, createdAt])
  @@map("quick_replies")
}

model CustomMenuGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  icon      String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buttons CustomMenuButton[]

  @@index([tenantId, active, position])
  @@map("custom_menu_groups")
}

model CustomMenuButton {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String
  url       String
  icon      String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  CustomMenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId, groupId, active, position])
  @@map("custom_menu_buttons")
}

model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tenantId, tagId])
  @@map("lead_tags")
}

model CustomerTag {
  customerId String   @map("customer_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tenantId, tagId])
  @@map("customer_tags")
}

model WhatsAppInstance {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  name                 String
  instanceName         String                 @unique @map("instance_name")
  externalInstanceId   String?                @map("external_instance_id")
  phone                String?
  status               WhatsAppInstanceStatus @default(DISCONNECTED)
  credentialsEncrypted String?                @map("credentials_encrypted")
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations       Conversation[]
  avatars             WhatsAppAvatar[]
  billingSettings     BillingSettings[]
  webhookIntegrations WebhookIntegration[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("whatsapp_instances")
}

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  whatsappInstanceId String             @map("whatsapp_instance_id") @db.Uuid
  externalContactId  String?            @map("external_contact_id")
  externalLid        String?            @map("external_lid")
  preferredAddress   String?            @map("preferred_address")
  customerId         String?            @map("customer_id") @db.Uuid
  contactId          String?            @map("contact_id") @db.Uuid
  status             ConversationStatus @default(OPEN)
  subject            String?
  isGroup            Boolean            @default(false) @map("is_group")
  groupName          String?            @map("group_name")
  avatarUrl          String?            @map("avatar_url")
  isPinned           Boolean            @default(false) @map("is_pinned")
  isArchived         Boolean            @default(false) @map("is_archived")
  deletedAt          DateTime?          @map("deleted_at")
  lastReadAt         DateTime?          @map("last_read_at")
  lastMessageAt      DateTime?          @map("last_message_at")
  closedAt           DateTime?          @map("closed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tags ConversationTag[]

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact  Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([whatsappInstanceId, externalContactId])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, isPinned, lastMessageAt])
  @@index([tenantId, isArchived, isPinned, lastMessageAt])
  @@map("conversations")
}

model ConversationTag {
  conversationId String   @map("conversation_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tenantId, tagId])
  @@map("conversation_tags")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  content           String?
  externalMessageId String?          @map("external_message_id")
  status            MessageStatus    @default(RECEIVED)
  senderId          String?          @map("sender_id")
  senderName        String?          @map("sender_name")
  metadata          Json             @default("{}")
  occurredAt        DateTime         @default(now()) @map("occurred_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@unique([tenantId, externalMessageId])
  @@index([tenantId, conversationId, occurredAt])
  @@index([tenantId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  size       Int
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, messageId])
  @@map("message_attachments")
}

model LinkPreview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  url         String
  urlKey      String   @map("url_key")
  status      String   @default("OK")
  title       String?
  description String?
  imageUrl    String?  @map("image_url")
  siteName    String?  @map("site_name")
  domain      String?
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, urlKey])
  @@index([tenantId, expiresAt])
  @@map("link_previews")
}

model WhatsAppAvatar {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  whatsappInstanceId String   @map("whatsapp_instance_id") @db.Uuid
  jid                String
  url                String?
  fetchedAt          DateTime @map("fetched_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@unique([whatsappInstanceId, jid])
  @@index([tenantId])
  @@map("whatsapp_avatars")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  provider        String    @default("evolution")
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payload         Json      @default("{}")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

model BillingCharge {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  customerId   String?             @map("customer_id") @db.Uuid
  contactId    String?             @map("contact_id") @db.Uuid
  recurrenceId String?             @map("recurrence_id") @db.Uuid
  description  String
  amountCents  Int                 @map("amount_cents")
  dueDate      DateTime            @map("due_date") @db.Date
  status       BillingChargeStatus @default(PENDING)
  paidAt       DateTime?           @map("paid_at")
  paidByUserId String?             @map("paid_by_user_id") @db.Uuid
  canceledAt   DateTime?           @map("canceled_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact    Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recurrence BillingRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  reminders  BillingReminder[]

  @@unique([recurrenceId, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@map("billing_charges")
}

model BillingRecurrence {
  id          String                     @id @default(uuid()) @db.Uuid
  tenantId    String                     @map("tenant_id") @db.Uuid
  customerId  String?                    @map("customer_id") @db.Uuid
  contactId   String?                    @map("contact_id") @db.Uuid
  description String
  amountCents Int                        @map("amount_cents")
  frequency   BillingRecurrenceFrequency @default(MONTHLY)
  startDate   DateTime                   @map("start_date") @db.Date
  nextRunDate DateTime                   @map("next_run_date") @db.Date
  endDate     DateTime?                  @map("end_date") @db.Date
  active      Boolean                    @default(true)
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  charges  BillingCharge[]

  @@index([tenantId, active])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@map("billing_recurrences")
}

model BillingSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  remindersEnabled    Boolean  @default(true) @map("reminders_enabled")
  reminderOffsets     Json     @default("[-3, 0, 3]") @map("reminder_offsets")
  messageTemplate     String   @default("Olá, *{cliente}*! 👋\n\nPassando para lembrar de uma cobrança que está próxima do vencimento.\n\n📋 *Descrição:* {descricao}\n💰 *Valor:* {valor}\n📅 *Vencimento:* {vencimento}\n\nPedimos que se organize para realizar o pagamento até a data informada.\n\nSe já realizou o pagamento, por favor, desconsidere esta mensagem.\n\nEm caso de dúvidas, estamos à disposição!\n\n*{nome_empresa}*") @map("message_template")
  whatsappInstanceId  String?  @map("whatsapp_instance_id") @db.Uuid
  sendWindowStartHour Int      @default(9) @map("send_window_start_hour")
  sendWindowEndHour   Int      @default(18) @map("send_window_end_hour")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)

  @@map("billing_settings")
}

model BillingReminder {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  chargeId           String                @map("charge_id") @db.Uuid
  offsetDays         Int                   @map("offset_days")
  origin             BillingReminderOrigin @default(AUTOMATIC)
  createdByUserId    String?               @map("created_by_user_id") @db.Uuid
  dedupeKey          String?               @map("dedupe_key")
  idempotencyKey     String?               @map("idempotency_key")
  scheduledFor       DateTime              @map("scheduled_for") @db.Date
  status             BillingReminderStatus @default(PENDING)
  attempts           Int                   @default(0)
  nextAttemptAt      DateTime?             @map("next_attempt_at")
  destination        String?
  whatsappInstanceId String?               @map("whatsapp_instance_id") @db.Uuid
  externalMessageId  String?               @map("external_message_id")
  errorMessage       String?               @map("error_message")
  processedAt        DateTime?             @map("processed_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge BillingCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([chargeId, dedupeKey])
  @@unique([chargeId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("billing_reminders")
}

model BulkMediaBatch {
