# ============================================================
# OrderUp CRM — backend
# Copie para .env e ajuste. Nunca commite o .env.
# ============================================================

# APP
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# DATABASE (Postgres 16 — `docker compose up -d`)
DATABASE_URL=postgresql://orderup:orderup@localhost:5432/orderup?schema=public

# REDIS (fila e realtime — `docker compose up -d`)
REDIS_URL=redis://localhost:6379

# AUTH
# Gere um segredo forte (>= 32 caracteres). Nunca commite valores reais.
JWT_ACCESS_SECRET=change-me-with-a-strong-secret-of-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# LOGGING (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=debug

# ============================================================
# ADMINISTRAÇÃO DA PLATAFORMA (área /admin)
# ============================================================
# E-mails com acesso para criar tenants e usuários (separados por vírgula).
# Cada e-mail precisa ter um usuário ativo com membership ativa no CRM.
PLATFORM_ADMIN_EMAILS=

# ============================================================
# WHATSAPP / EVOLUTION API (serviço externo)
# Suba a Evolution com:
#   docker compose -f docker-compose.yml -f docker-compose.evolution.yml up -d
# ============================================================

# Criptografa credenciais de instância em repouso (>= 32 caracteres).
CREDENTIALS_ENCRYPTION_KEY=change-me-with-a-strong-secret-of-32-chars

# bullmq (padrão) ou inline (processa jobs no próprio request; usado em testes)
QUEUE_DRIVER=bullmq

# Rate limit em endpoints sensíveis (login/refresh/webhook).
RATE_LIMIT_ENABLED=true

# Para habilitar o WhatsApp, preencha as quatro variáveis abaixo.
# Deixe EVOLUTION_API_BASE_URL vazio para desabilitar o WhatsApp.
# EVOLUTION_API_KEY deve ser igual ao AUTHENTICATION_API_KEY da Evolution.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
# Segredo validado no webhook (?token=... ou header x-webhook-secret).
EVOLUTION_WEBHOOK_SECRET=
# URL do backend que a Evolution usa para entregar o webhook.
# Dev local (Evolution em container, backend no host):
#   PUBLIC_API_URL=http://host.docker.internal:3000
# Alternativa (túnel, precisa ser alcançável PELA Evolution):
#   PUBLIC_API_URL=https://<seu-tunel-publico>
PUBLIC_API_URL=

# Diagnóstico temporário do webhook (desligado por padrão; remover após validar).
# WEBHOOK_DEBUG=true registra evento, ids, decisão e resultado da normalização (sem conteúdo).
# WEBHOOK_DEBUG_PAYLOAD=true inclui o payload bruto redigido (nunca tokens/senhas).
WEBHOOK_DEBUG=
WEBHOOK_DEBUG_PAYLOAD=

# ============================================================
# INTELIGÊNCIA ARTIFICIAL
# ============================================================
# A configuração de provedor/modelo/credencial é feita por organização em
# Configurações → IA. A CREDENTIALS_ENCRYPTION_KEY acima protege as credenciais
# de IA em repouso; sem ela não é possível salvar credenciais.
AI_TIMEOUT_MS=30000

# ============================================================
# MÍDIA / STORAGE
# ============================================================
# local (padrão) grava em disco. minio/s3 ainda não implementados.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# Tamanho máximo do arquivo bruto recebido/enviado (bytes). Padrão: 25 MB.
MEDIA_MAX_BYTES=26214400
# Otimização de imagem (JPEG): dimensão máxima e qualidade.
MEDIA_IMAGE_MAX_DIMENSION=1600
MEDIA_IMAGE_QUALITY=80
# Dimensão máxima da miniatura.
MEDIA_THUMBNAIL_DIMENSION=256
# Foto de perfil: tamanho máximo do upload e lado da imagem quadrada gerada.
AVATAR_MAX_BYTES=5242880
AVATAR_DIMENSION=512

# Pré-visualização de links (metadados Open Graph obtidos pelo backend).
LINK_PREVIEW_TIMEOUT_MS=5000
LINK_PREVIEW_MAX_BYTES=524288
LINK_PREVIEW_CACHE_TTL_SECONDS=604800
LINK_PREVIEW_FAILURE_TTL_SECONDS=21600

# ============================================================
# COBRANÇAS
# ============================================================
# Fuso horário usado para calcular vencimentos, vencidos e o horário de
# envio dos lembretes. Use um identificador IANA (ex.: America/Sao_Paulo).
BILLING_TIMEZONE=America/Sao_Paulo

# ============================================================
# ENVIO DE FOTO EM MASSA (câmera)
# ============================================================
# Máximo de conversas por envio e intervalo entre destinatários (anti-bloqueio).
BULK_MEDIA_MAX_RECIPIENTS=100
BULK_MEDIA_INTERVAL_MS=1500

# ============================================================
# MENSAGENS AGENDADAS (campanhas e lembretes)
# ============================================================
SCHEDULED_MESSAGE_SCAN_INTERVAL_MS=60000
SCHEDULED_MESSAGE_INTERVAL_MS=1500
SCHEDULED_MESSAGE_MAX_ATTEMPTS=3
SCHEDULED_MESSAGE_MAX_RECIPIENTS=100
SCHEDULED_MESSAGE_TIMEZONE=America/Sao_Paulo

# Endpoint/credenciais apenas quando STORAGE_PROVIDER=minio|s3 (futuro)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=
