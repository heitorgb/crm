# ============================================================
# OrderUp CRM — variáveis do docker-compose.prod.yml (produção)
# Copie para `.env` (na raiz do repositório, no servidor) e ajuste.
#   cp .env.example .env
# NÃO commite o `.env`.
# ============================================================

# Postgres interno do CRM
POSTGRES_USER=orderup
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=orderup

# Porta pública do frontend (nginx). Use 80 atrás de um proxy/TLS ou outra livre.
HTTP_PORT=80

# Porta publicada no host para a API. A API escuta em 3000 DENTRO do container;
# este valor evita conflito com serviços que já usam a 3000 no servidor.
BACKEND_PORT=4100
