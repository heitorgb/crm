generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum AiProvider {
  OPENAI
  DEEPSEEK
  ANTHROPIC
  OPENROUTER
}

enum AiFormality {
  PROFESSIONAL
  FORMAL
  VERY_FORMAL
}

enum LeadRecommendationKind {
  NEXT_ACTION
  LEAD_UPDATE
}

enum LeadRecommendationStatus {
  RECOMMENDED
  ACCEPTED
  REJECTED
  EXECUTED
  CANCELED
}

enum LeadRecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadUpdateField {
  NEED
  PRODUCT
  BUDGET
  DEADLINE
  USERS
  REQUIREMENTS
  OBJECTION
  STAGE
  LOSS_REASON
  NOTES
}

enum LeadFollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WhatsAppInstanceStatus {
  CONNECTED
  CONNECTING
  DISCONNECTED
  ERROR
}

enum WhatsAppHistorySyncStatus {
  IDLE
  SYNCING
  COMPLETED
  FAILED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  REACTION
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum TranscriptionStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BillingChargeStatus {
  PENDING
  PAID
  CANCELED
}

enum BillingRecurrenceFrequency {
  MONTHLY
}

enum BillingReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum BillingReminderOrigin {
  AUTOMATIC
  MANUAL
}

enum BulkMediaBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum BulkMediaRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum ScheduledMessageType {
  CAMPAIGN
  REMINDER
}

enum ScheduledMessageStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELED
}

enum ScheduledMessageRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduledMessageRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum WebhookExecutionStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum LeadStageKind {
  OPEN
  WON
  LOST
}

model Tenant {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  whatsappInstanceLimit Int      @default(3) @map("whatsapp_instance_limit")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  members                    TenantUser[]
  refreshTokens              RefreshToken[]
  customers                  Customer[]
  contacts                   Contact[]
  tags                       Tag[]
  customerTags               CustomerTag[]
  conversationTags           ConversationTag[]
  leadTags                   LeadTag[]
  quickReplies               QuickReply[]
  whatsappInstances          WhatsAppInstance[]
  whatsappAvatars            WhatsAppAvatar[]
  conversations              Conversation[]
  conversationParticipants   ConversationParticipant[]
  messages                   Message[]
  messageAttachments         MessageAttachment[]
  messageTranscriptions      MessageTranscription[]
  messageReactions           MessageReaction[]
  webhookEvents              WebhookEvent[]
  billingCharges             BillingCharge[]
  billingRecurrences         BillingRecurrence[]
  billingSettings            BillingSettings?
  billingReminders           BillingReminder[]
  bulkMediaBatches           BulkMediaBatch[]
  bulkMediaRecipients        BulkMediaRecipient[]
  scheduledMessages          ScheduledMessage[]
  scheduledMessageRecipients ScheduledMessageRecipient[]
  modules                    TenantModule[]
  webhookIntegrations        WebhookIntegration[]
  webhookExecutions          WebhookExecution[]
  linkPreviews               LinkPreview[]
  leadPipelines              LeadPipeline[]
  leadStages                 LeadStage[]
  leads                      Lead[]
  customMenuGroups           CustomMenuGroup[]
  customMenuButtons          CustomMenuButton[]
  aiSettings                 AiSettings?
  leadCommercialContexts     LeadCommercialContext[]
  leadRecommendations        LeadRecommendation[]
  leadFollowUps              LeadFollowUp[]

  @@map("tenants")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String    @map("password_hash")
  name             String
  active           Boolean   @default(true)
  avatarStorageKey String?   @map("avatar_storage_key")
  avatarUpdatedAt  DateTime? @map("avatar_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  memberships         TenantUser[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model TenantUser {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedLeads              Lead[]               @relation("LeadOwner")
  recommendationDecisions LeadRecommendation[] @relation("RecommendationDecidedBy")
  ownedFollowUps          LeadFollowUp[]       @relation("FollowUpOwner")
  createdFollowUps        LeadFollowUp[]       @relation("FollowUpCreatedBy")

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  document  String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  tags               CustomerTag[]
  conversations      Conversation[]
  billingCharges     BillingCharge[]
  billingRecurrences BillingRecurrence[]

  @@unique([tenantId, document])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("customers")
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  birthDate  DateTime? @map("birth_date") @db.Date
  address    String?
  position   String?
  avatarUrl  String?   @map("avatar_url")
  isPrimary  Boolean   @default(false) @map("is_primary")
  isBlocked  Boolean   @default(false) @map("is_blocked")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  billingCharges     BillingCharge[]
  billingRecurrences BillingRecurrence[]
  leads              Lead[]

  @@unique([tenantId, phone])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

model LeadPipeline {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages LeadStage[]
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("lead_pipelines")
}

model LeadStage {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  pipelineId String        @map("pipeline_id") @db.Uuid
  name       String
  color      String?
  position   Int
  kind       LeadStageKind @default(OPEN)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline LeadPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, position])
  @@index([tenantId, pipelineId])
  @@map("lead_stages")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  pipelineId     String     @map("pipeline_id") @db.Uuid
  stageId        String     @map("stage_id") @db.Uuid
  contactId      String     @map("contact_id") @db.Uuid
  ownerId        String?    @map("owner_id") @db.Uuid
  title          String
  source         String?
  valueCents     Int        @default(0) @map("value_cents")
  status         LeadStatus @default(OPEN)
  notes          String?
  nextFollowUpAt DateTime?  @map("next_follow_up_at")
  closedAt       DateTime?  @map("closed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline          LeadPipeline           @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             LeadStage              @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact           Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner             TenantUser?            @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags              LeadTag[]
  commercialContext LeadCommercialContext?
  recommendations   LeadRecommendation[]
  followUps         LeadFollowUp[]

  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, ownerId])
  @@index([tenantId, nextFollowUpAt])
  @@map("leads")
}

model LeadCommercialContext {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  leadId                String    @unique @map("lead_id") @db.Uuid
  conversationId        String?   @map("conversation_id") @db.Uuid
  summary               String
  objective             String
  need                  String
  confirmedFacts        Json      @default("[]") @map("confirmed_facts")
  hypotheses            Json      @default("[]")
  pendingInformation    Json      @default("[]") @map("pending_information")
  nextQuestion          String    @map("next_question")
  suggestedReply        String    @map("suggested_reply")
  rationale             String
  provider              String
  model                 String
  promptVersion         String    @map("prompt_version")
  analysisVersion       Int       @default(1) @map("analysis_version")
  latestMessageId       String?   @map("latest_message_id")
  latestMessageAt       DateTime? @map("latest_message_at")
  latestTranscriptionAt DateTime? @map("latest_transcription_at")
  leadUpdatedAt         DateTime  @map("lead_updated_at")
  lastAnalyzedAt        DateTime  @map("last_analyzed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead            Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation    Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  recommendations LeadRecommendation[]

  @@index([tenantId, conversationId])
  @@map("lead_commercial_contexts")
}

model LeadRecommendation {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @map("tenant_id") @db.Uuid
  leadId                String                     @map("lead_id") @db.Uuid
  conversationId        String?                    @map("conversation_id") @db.Uuid
  contextId             String?                    @map("context_id") @db.Uuid
  analysisVersion       Int                        @map("analysis_version")
  kind                  LeadRecommendationKind
  status                LeadRecommendationStatus   @default(RECOMMENDED)
  priority              LeadRecommendationPriority
  action                String
  reason                String
  expectedOutcome       String?                    @map("expected_outcome")
  missingInformation    Json                       @default("[]") @map("missing_information")
  suggestedDueAt        DateTime?                  @map("suggested_due_at")
  suggestedMessage      String?                    @map("suggested_message")
  updateField           LeadUpdateField?           @map("update_field")
  proposedValue         String?                    @map("proposed_value")
  evidence              String?
  decidedAt             DateTime?                  @map("decided_at")
  decidedByMembershipId String?                    @map("decided_by_membership_id") @db.Uuid
  result                Json                       @default("{}")
  beforeData            Json                       @default("{}") @map("before_data")
  afterData             Json                       @default("{}") @map("after_data")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  context      LeadCommercialContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  decidedBy    TenantUser?            @relation("RecommendationDecidedBy", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)
  followUp     LeadFollowUp?

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, leadId, analysisVersion])
  @@index([tenantId, status])
  @@map("lead_recommendations")
}

model LeadFollowUp {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  leadId                String             @map("lead_id") @db.Uuid
  conversationId        String?            @map("conversation_id") @db.Uuid
  recommendationId      String?            @unique @map("recommendation_id") @db.Uuid
  ownerId               String?            @map("owner_id") @db.Uuid
  createdByMembershipId String?            @map("created_by_membership_id") @db.Uuid
  idempotencyKey        String?            @map("idempotency_key")
  action                String
  reason                String?
  dueAt                 DateTime?          @map("due_at")
  suggestedMessage      String?            @map("suggested_message")
  status                LeadFollowUpStatus @default(PENDING)
  completedAt           DateTime?          @map("completed_at")
  canceledAt            DateTime?          @map("canceled_at")
  rescheduleCount       Int                @default(0) @map("reschedule_count")
  lastRescheduledAt     DateTime?          @map("last_rescheduled_at")
  events                Json               @default("[]")
  result                Json               @default("{}")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  recommendation LeadRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  owner          TenantUser?         @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      TenantUser?         @relation("FollowUpCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, leadId, status, dueAt])
  @@map("lead_follow_ups")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers     CustomerTag[]
  conversations ConversationTag[]
  leads         LeadTag[]

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
  @@map("tags")
}

model QuickReply {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, title])
  @@index([tenantId, createdAt])
  @@map("quick_replies")
}

model CustomMenuGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  icon      String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buttons CustomMenuButton[]

  @@index([tenantId, active, position])
  @@map("custom_menu_groups")
}

model CustomMenuButton {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String
  url       String
  icon      String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  CustomMenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId, groupId, active, position])
  @@map("custom_menu_buttons")
}

model LeadTag {
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tenantId, tagId])
  @@map("lead_tags")
}

model CustomerTag {
  customerId String   @map("customer_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tenantId, tagId])
  @@map("customer_tags")
}

model WhatsAppInstance {
  id                     String                    @id @default(uuid()) @db.Uuid
  tenantId               String                    @map("tenant_id") @db.Uuid
  name                   String
  instanceName           String                    @unique @map("instance_name")
  externalInstanceId     String?                   @map("external_instance_id")
  phone                  String?
  status                 WhatsAppInstanceStatus    @default(DISCONNECTED)
  credentialsEncrypted   String?                   @map("credentials_encrypted")
  active                 Boolean                   @default(true)
  historySyncStatus      WhatsAppHistorySyncStatus @default(IDLE) @map("history_sync_status")
  historySyncProgress    Int?                      @map("history_sync_progress")
  historySyncStartedAt   DateTime?                 @map("history_sync_started_at")
  historySyncCompletedAt DateTime?                 @map("history_sync_completed_at")
  historySyncError       String?                   @map("history_sync_error")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations       Conversation[]
  avatars             WhatsAppAvatar[]
  billingSettings     BillingSettings[]
  webhookIntegrations WebhookIntegration[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("whatsapp_instances")
}

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  whatsappInstanceId String             @map("whatsapp_instance_id") @db.Uuid
  externalContactId  String?            @map("external_contact_id")
  externalLid        String?            @map("external_lid")
  preferredAddress   String?            @map("preferred_address")
  customerId         String?            @map("customer_id") @db.Uuid
  contactId          String?            @map("contact_id") @db.Uuid
  status             ConversationStatus @default(OPEN)
  subject            String?
  isGroup            Boolean            @default(false) @map("is_group")
  groupName          String?            @map("group_name")
  avatarUrl          String?            @map("avatar_url")
  isPinned           Boolean            @default(false) @map("is_pinned")
  isArchived         Boolean            @default(false) @map("is_archived")
  deletedAt          DateTime?          @map("deleted_at")
  lastReadAt         DateTime?          @map("last_read_at")
  lastMessageAt      DateTime?          @map("last_message_at")
  closedAt           DateTime?          @map("closed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tags ConversationTag[]

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance           WhatsAppInstance        @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  customer           Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact            Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages           Message[]
  participants       ConversationParticipant[]
  reactions          MessageReaction[]
  commercialContexts LeadCommercialContext[]
  recommendations    LeadRecommendation[]
  followUps          LeadFollowUp[]

  @@unique([whatsappInstanceId, externalContactId])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, isPinned, lastMessageAt])
  @@index([tenantId, isArchived, isPinned, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
