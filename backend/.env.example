# APP
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# DATABASE
DATABASE_URL=postgresql://orderup:orderup@localhost:5432/orderup?schema=public

# REDIS
REDIS_URL=redis://localhost:6379

# AUTH
# Gere um segredo forte (>= 32 caracteres). Nunca commite valores reais.
JWT_ACCESS_SECRET=change-me-with-a-strong-secret-of-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# LOGGING
LOG_LEVEL=debug

# AI (fundação; nenhuma chamada é feita nesta fase)
# As chaves de negócio do bot (critérios, tom, perguntas) são dados do tenant, não variáveis de ambiente.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ATENDIMENTO / WHATSAPP
# Chave usada para criptografar credenciais de instância em repouso (>= 32 caracteres).
CREDENTIALS_ENCRYPTION_KEY=change-me-with-a-strong-secret-of-32-chars
# bullmq (padrão) ou inline (processa jobs no próprio request; usado em testes)
QUEUE_DRIVER=bullmq
# Rate limit em endpoints sensíveis (login/refresh/webhook). Default: true
RATE_LIMIT_ENABLED=true
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
# Segredo esperado no webhook (?token=... ou header x-webhook-secret)
EVOLUTION_WEBHOOK_SECRET=
# URL pública do backend, usada para registrar o webhook na Evolution.
# Em dev local, use um túnel (ngrok/cloudflared) apontando para o backend.
PUBLIC_API_URL=

# STORAGE (mídia; preparado para MinIO/S3 — não implementado nesta fase)
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# LGPD / COMPLIANCE
# Versões vigentes dos documentos legais aceitos pelo tenant.
LEGAL_TERMS_VERSION=2026-01
LEGAL_DPA_VERSION=2026-01
# Canal de fallback do Encarregado da OrderUp (suporte técnico; o tenant é o Controlador).
ORDERUP_DPO_NAME=OrderUp — Encarregado de Dados
ORDERUP_DPO_EMAIL=privacidade@orderup.com.br
