# ============================================================
# OrderUp CRM — variáveis do docker-compose.prod.yml (produção)
# Copie para `.env` (na raiz do repositório, no servidor) e ajuste.
#   cp .env.example .env
# NÃO commite o `.env`.
# ============================================================

# Postgres interno do CRM
POSTGRES_USER=orderup
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=orderup

# Porta pública do frontend (nginx). Use 80 atrás de um proxy/TLS ou outra livre.
HTTP_PORT=80

# Porta publicada no host para a API. A API escuta em 3000 DENTRO do container;
# este valor evita conflito com serviços que já usam a 3000 no servidor.
BACKEND_PORT=4100

# Evolution API (stack separado — docker-compose.evolution.yml e scripts/deploy.sh).
# Default do compose: 2.4.0-rc2. Para rollback use 2.3.8; o deploy normaliza para
# a tag publicada no Docker Hub (`v2.3.8`). `EVOLUTION_IMAGE` tem precedência.
# EVOLUTION_API_VERSION=2.4.0-rc2
# EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.8
